                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"company_ids\": [\n    \"<integer>\"\n  ],\n  \"segment_type\": \"business\",\n  \"period_type\": \"ltm\",\n  \"start_year\": \"<integer>\",\n  \"end_year\": \"<integer>\",\n  \"start_quarter\": 2,\n  \"end_quarter\": 1,\n  \"calendar_type\": \"fiscal\",\n  \"num_periods\": \"<integer>\",\n  \"num_periods_back\": \"<integer>\"\n}",
                      "options": {
