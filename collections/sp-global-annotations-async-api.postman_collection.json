          "id": "87b55da8-afb6-4541-a129-350296cf5b25",
          "name": "Start A NERD Annotation Job",
          "request": {
            "name": "Start A NERD Annotation Job",
            "description": {
              "content": "Submit a document to NERD to kick off an annotation job that will be processed asynchronously. Endpoint users submit a text document and at least one knowledge base to be used to annotate the detected entities. There are two available knowledge bases, the Wikimedia knowledge base and the Capital IQ knowledge base, denoted `\"wikimedia\"` and `\"capiq\"`, respectively.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "annotations-async"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"knowledge_bases\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"tag_people\": \"<boolean>\",\n  \"text\": \"<string>\",\n  \"originating_entity_id\": \"<string>\",\n  \"request_id\": \"<string>\"\n}",
